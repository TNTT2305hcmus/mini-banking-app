# CA Service environment template

GRPC_PORT=50051

# Root CA. The root key signs intermediate CAs only.
ROOT_CA_KEY_PATH=certs/root-ca/ca.key
ROOT_CA_CERT_PATH=certs/root-ca/ca.crt
ROOT_CA_KEY_PASSWORD=replace_with_the_root_ca_key_password

# Client CA signs customer, bank_admin and ca_admin identity certificates.
CLIENT_CA_KEY_PATH=certs/intermediate/client-ca.key
CLIENT_CA_CERT_PATH=certs/intermediate/client-ca.crt

# Issued certificate material and metadata store.
ISSUED_CERTS_PATH=certs/issued
CA_STORE_BACKEND=postgres
CA_STORE_STATE_PATH=certs/ca-store/state.json
CA_DATABASE_URL=postgres://ca_user:replace_with_ca_db_password@localhost:5433/ca_db?sslmode=disable
CERT_VALIDITY_DAYS=365
CA_CRL_DISTRIBUTION_POINTS=
CA_OCSP_SERVERS=

# gRPC TLS server certificate signed by the gRPC Transport CA.
GRPC_SERVER_CERT_PATH=certs/grpc/ca-server.crt
GRPC_SERVER_KEY_PATH=certs/grpc/ca-server.key
