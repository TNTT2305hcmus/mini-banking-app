# API Gateway environment template

NODE_ENV=development
PORT=3000
FRONTEND_BASE_URL=http://localhost:5173
GATEWAY_REDIS_URL=redis://localhost:6379/0

# gRPC trust bundle and service addresses.
CA_CERT_PATH=certs/grpc-ca.crt
CA_GRPC_ADDR=localhost:50051
KDC_GRPC_ADDR=localhost:50052
BANK_GRPC_ADDR=localhost:50053

# Email / OTP.
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
OTP_MAX_ATTEMPTS=5
OTP_EXPIRES_IN=300
OTP_COOLDOWN=60
GATEWAY_OTP_SECRET=replace_with_random_otp_secret

# JWT/session signing.
GATEWAY_JWT_SECRET=replace_with_at_least_32_characters_random_secret
ADMIN_ACTIVATION_TTL_SECONDS=900

# Rehearsal/demo rate limits. Set RATE_LIMIT_DISABLED=1 only for demo runs.
RATE_LIMIT_DISABLED=0
RATE_LIMIT_AS_WINDOW_SECONDS=300
RATE_LIMIT_AS_MAX=10
RATE_LIMIT_TGS_WINDOW_SECONDS=300
RATE_LIMIT_TGS_MAX=10
RATE_LIMIT_BANK_WINDOW_SECONDS=60
RATE_LIMIT_BANK_MAX=20
RATE_LIMIT_OTP_WINDOW_SECONDS=600
RATE_LIMIT_OTP_MAX=3

# Security Operations (SOC) demo login. Leave empty to fail closed.
ADMIN_SEC_DEMO_EMAIL=security@minibanking.local
ADMIN_SEC_DEMO_PASSWORD=replace_with_security_admin_password
ADMIN_SEC_DEMO_TOKEN=replace_with_security_admin_demo_token
