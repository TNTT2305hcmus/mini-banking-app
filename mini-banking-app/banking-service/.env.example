# Banking Service environment template

BANK_GRPC_PORT=50053
DATABASE_URL=postgres://banking:replace_with_bank_db_password@localhost:5432/banking?sslmode=disable
REDIS_URI=redis://localhost:6379/0

# Demo service key. For terminal runs this can point to the KDC provisioned key.
BANK_KEY=../kdc-service/certs/k_tgs.key

# CA gRPC client.
CA_SERVICE_ADDRESS=localhost:50051
CA_CERT_PATH=certs/grpc-ca.crt
CA_TLS_SERVER_NAME=ca-service

# Bank gRPC TLS server certificate.
BANK_CERT_PATH=certs/grpc/bank-server.crt
BANK_KEY_PATH=certs/grpc/bank-server.key
