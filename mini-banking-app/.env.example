# Mini Banking shared environment template
#
# Copy this file to `.env` only when you use docker compose from this folder.
# When running services locally with 4 terminals, each service reads its own
# `.env` file inside ca-service, kdc-service, banking-service, and api-gateway.

# ----- Docker compose / shared values -----
API_GATEWAY_PORT=3000
CA_GRPC_PORT=50051

# CA service in docker-compose.yml is currently configured for Postgres.
# For local terminal runs, ca-service/.env defaults to CA_STORE_BACKEND=json
# so you can skip CA Postgres while developing.
ROOT_CA_KEY_PASSWORD=dev-root-ca-password-change-me
CA_STORE_BACKEND=postgres
CA_DATABASE_URL=postgres://ca_user:MiniBankingDev123!@host.docker.internal:5433/ca_db?sslmode=disable
CERT_VALIDITY_DAYS=365
CA_CRL_DISTRIBUTION_POINTS=http://localhost:8080/ca/crl.pem
CA_OCSP_SERVERS=http://localhost:8080/ca/ocsp

# Gateway
FRONTEND_BASE_URL=http://localhost:5173
GATEWAY_REDIS_URL=redis://gateway-redis:6379
JWT_SECRET=dev-jwt-secret-change-me-at-least-32-chars
GATEWAY_OTP_SECRET=dev-otp-secret-change-me
OTP_MAX_ATTEMPTS=5
OTP_EXPIRES_IN=300
OTP_COOLDOWN=60
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password

# Internal gRPC addresses on Docker network.
KDC_GRPC_ADDR=kdc-service:50052
BANK_GRPC_ADDR=banking-service:50053

# Optional local database defaults used by the guide when you run services
# directly on the host.
LOCAL_BANK_DATABASE_URL=postgres://banking:MiniBankingDev123!@localhost:5432/banking?sslmode=disable
LOCAL_CA_DATABASE_URL=postgres://ca_user:MiniBankingDev123!@localhost:5433/ca_db?sslmode=disable
