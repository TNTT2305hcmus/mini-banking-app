# Mini Banking App - local demo environment.
#
# For a clean-machine demo:
#   Copy-Item .\.env.demo.example .\.env
#
# This file intentionally contains demo-only local values so Docker Compose can
# run immediately after copying. Do not use these values for production.
# Replace SMTP_USER/SMTP_PASS only when you want to test real OTP or admin
# activation email delivery.

API_GATEWAY_PORT=3000
CA_GRPC_PORT=50051
KDC_GRPC_PORT=50052
BANK_GRPC_PORT=50053
BANK_POSTGRES_PORT=5432
REDIS_PORT=6379
FRONTEND_PORT=5173

ROOT_CA_KEY_PASSWORD=dev-root-ca-password-change-me
CA_STORE_BACKEND=postgres
CA_DB_NAME=ca_db
CA_DB_USER=ca_user
CA_DB_PASSWORD=MiniBankingDev123!
CA_DATABASE_URL=postgresql://ca_user:MiniBankingDev123!@ca-postgres:5432/ca_db?sslmode=disable
CERT_VALIDITY_DAYS=365
CA_CRL_DISTRIBUTION_POINTS=
CA_OCSP_SERVERS=

TGT_EXP=10m

BANK_DB_NAME=banking
BANK_DB_USER=banking
BANK_DB_PASSWORD=MiniBankingDev123!

FRONTEND_BASE_URL=http://localhost:5173
GATEWAY_REDIS_URL=redis://gateway-redis:6379/0

JWT_SECRET=dev-jwt-secret-change-me-at-least-32-chars
GATEWAY_OTP_SECRET=dev-otp-secret-change-me-at-least-32-chars

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password

OTP_MAX_ATTEMPTS=5
OTP_EXPIRES_IN=300
OTP_COOLDOWN=60
DEMO_OTP=123456
ADMIN_ACTIVATION_TTL_SECONDS=900

RATE_LIMIT_DISABLED=1
RATE_LIMIT_AS_WINDOW_SECONDS=300
RATE_LIMIT_AS_MAX=10
RATE_LIMIT_TGS_WINDOW_SECONDS=300
RATE_LIMIT_TGS_MAX=10
RATE_LIMIT_BANK_WINDOW_SECONDS=60
RATE_LIMIT_BANK_MAX=20
RATE_LIMIT_OTP_WINDOW_SECONDS=600
RATE_LIMIT_OTP_MAX=3

KDC_GRPC_ADDR=kdc-service:50052
BANK_GRPC_ADDR=banking-service:50053

ADMIN_CA_TOKEN=
ADMIN_SEC_DEMO_EMAIL=security@minibanking.local
ADMIN_SEC_DEMO_PASSWORD=dev-security-admin-password-change-me
ADMIN_SEC_DEMO_TOKEN=dev-security-admin-token-change-me

SKIP_SMTP_CHECK=1
DEMO_EMAIL=customer.demo@demo.minibanking.local

LOCAL_BANK_DATABASE_URL=postgres://banking:MiniBankingDev123!@localhost:5432/banking?sslmode=disable
LOCAL_CA_DATABASE_URL=postgres://ca_user:MiniBankingDev123!@localhost:5433/ca_db?sslmode=disable
LOCAL_KDC_DATABASE_URL=postgres://banking:MiniBankingDev123!@localhost:5432/banking?sslmode=disable

VITE_API_BASE_URL=http://localhost:3000
