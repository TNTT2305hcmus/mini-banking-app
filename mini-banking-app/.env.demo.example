# =============================================================================
# .env.demo.example — Mini Banking Demo Environment Variables
# =============================================================================
#
# Sao chép file này thành .env và điền các giá trị thật trước khi chạy demo:
#   cp .env.demo.example .env
#
# ⚠️  DANH SÁCH SECRET BẮT BUỘC ĐỔI TRƯỚC KHI DEMO:
#   1. ROOT_CA_KEY_PASSWORD   — mật khẩu bảo vệ private key của Root CA
#   2. JWT_SECRET             — secret ký JWT của API Gateway (≥32 ký tự)
#   3. GATEWAY_OTP_SECRET     — secret HMAC cho OTP
#   4. SMTP_USER              — Gmail/SMTP account để gửi OTP
#   5. SMTP_PASS              — Gmail App Password (không phải mật khẩu Gmail thường)
#   6. BANK_DB_PASSWORD       — mật khẩu Postgres cho Banking Service
#   7. BANK_KEY               — 64-character hex key cho Banking Service (AES)
#   8. CA_DATABASE_URL        — connection string tới CA Postgres (Neon hoặc local)
#
# Nếu dùng ca-postgres nội bộ (thay vì Neon), thêm:
#   9. CA_DB_PASSWORD         — mật khẩu ca-postgres
#
# =============================================================================

# ─── Docker Compose / Shared ─────────────────────────────────────────────────
API_GATEWAY_PORT=3000
CA_GRPC_PORT=50051
KDC_GRPC_PORT=50052
BANK_GRPC_PORT=50053
BANK_POSTGRES_PORT=5432
REDIS_PORT=6379
FRONTEND_PORT=5173

# ─── CA Service ──────────────────────────────────────────────────────────────
# ⚠️ THAY ĐỔI BẮT BUỘC
ROOT_CA_KEY_PASSWORD=REPLACE_WITH_ROOT_CA_KEY_PASSWORD

# CA Database — Neon (external) hoặc postgresql://ca_user:pass@ca-postgres:5432/ca_db?sslmode=disable
# ⚠️ THAY ĐỔI BẮT BUỘC
CA_DATABASE_URL=REPLACE_WITH_CA_DATABASE_URL_NEON_OR_LOCAL

# Nếu dùng ca-postgres nội bộ (uncomment ca-postgres trong compose):
# CA_DB_NAME=ca_db
# CA_DB_USER=ca_user
# CA_DB_PASSWORD=REPLACE_WITH_CA_DB_PASSWORD

CERT_VALIDITY_DAYS=365
CA_CRL_DISTRIBUTION_POINTS=
CA_OCSP_SERVERS=

# ─── KDC Service ─────────────────────────────────────────────────────────────
TGT_EXP=10m

# ─── Banking Service ─────────────────────────────────────────────────────────
BANK_DB_NAME=banking
BANK_DB_USER=banking
# ⚠️ THAY ĐỔI BẮT BUỘC
BANK_DB_PASSWORD=REPLACE_WITH_BANK_DB_PASSWORD

# 64-character hex key cho AES encryption trong Banking Service
# Tạo: openssl rand -hex 32
# ⚠️ THAY ĐỔI BẮT BUỘC
BANK_KEY=REPLACE_WITH_64_CHARACTER_HEX_KEY_openssl_rand_hex_32

# ─── API Gateway ─────────────────────────────────────────────────────────────
FRONTEND_BASE_URL=http://localhost:5173

# Redis URL — dùng tên service 'gateway-redis' (giống docker-compose.yml gốc)
GATEWAY_REDIS_URL=redis://gateway-redis:6379/0

# JWT Secret — tối thiểu 32 ký tự
# ⚠️ THAY ĐỔI BẮT BUỘC
JWT_SECRET=REPLACE_WITH_JWT_SECRET_AT_LEAST_32_CHARACTERS_RANDOM

# OTP Secret
# ⚠️ THAY ĐỔI BẮT BUỘC
GATEWAY_OTP_SECRET=REPLACE_WITH_RANDOM_OTP_SECRET

# SMTP (Gmail) — cần thiết để gửi OTP qua email
# Nếu test không cần email: set SKIP_SMTP_CHECK=1 trong smoke-test.sh
# ⚠️ THAY ĐỔI BẮT BUỘC (hoặc dùng SKIP_SMTP_CHECK=1 khi demo không có email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_YOUR_GMAIL
SMTP_PASS=REPLACE_WITH_GMAIL_APP_PASSWORD

OTP_MAX_ATTEMPTS=5
OTP_EXPIRES_IN=300
OTP_COOLDOWN=60
ADMIN_ACTIVATION_TTL_SECONDS=900

# gRPC internal addresses — KHÔNG đổi khi dùng Docker Compose nội bộ
KDC_GRPC_ADDR=kdc-service:50052
BANK_GRPC_ADDR=banking-service:50053

# ─── Admin Credentials (Demo only — lưu trong env, không hardcode trong code) ─
# Admin CA (dùng cho smoke-test.sh và Admin CA Dashboard)
CA_DEMO_EMAIL=admin@minibanking.local
CA_DEMO_PASSWORD=REPLACE_WITH_ADMIN_CA_PASSWORD

# ─── Smoke test config ────────────────────────────────────────────────────────
# 1 = bỏ qua bước OTP khi SMTP chưa cấu hình
SKIP_SMTP_CHECK=0

# Email dùng để test OTP trong smoke test (phải là email alice trong seed_demo.sql)
DEMO_EMAIL=alice@demo.minibanking.local

# ─── Local dev (host machine, không phải Docker) ─────────────────────────────
# Dùng khi chạy service trực tiếp trên máy host (không qua Docker Compose)
LOCAL_BANK_DATABASE_URL=postgres://banking:REPLACE_WITH_BANK_DB_PASSWORD@localhost:5432/banking?sslmode=disable
LOCAL_CA_DATABASE_URL=postgres://ca_user:REPLACE_WITH_CA_DB_PASSWORD@localhost:5433/ca_db?sslmode=disable

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000
