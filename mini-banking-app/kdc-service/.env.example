# KDC Service environment template

GRPC_PORT=50052
TGT_EXP=10m
REDIS_URI=redis://localhost:6379/0

# CA gRPC client.
CA_PORT=localhost:50051
CA_CERT_PATH=certs/grpc-ca.crt
CA_SERVER_NAME=ca-service

# Optional KDC audit DB. If unset, KDC still issues AS/TGS tickets but audit is no-op.
DATABASE_URL=postgres://banking:replace_with_bank_db_password@localhost:5432/banking?sslmode=disable

# Ticket keys.
K_TGS_PATH=certs/k_tgs.key
KDC_PRIVATE_KEY_PATH=certs/kdc-private.pem
BANK_SERVICE_ID=bank-service
BANK_SERVICE_KEY_PATH=certs/k_tgs.key

# KDC gRPC TLS server certificate.
KDC_SERVER_CERT_PATH=certs/kdc-server.crt
KDC_SERVER_KEY_PATH=certs/kdc-server.key
KDC_SERVER_CA_CERT_PATH=certs/grpc-ca.crt
