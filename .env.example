# ================================================
# Mini_App_Banking — Environment Variables
# ================================================
# HƯỚNG DẪN:
#   1. Copy file này thành .env
#      Windows CMD:  copy .env.example .env
#      PowerShell:   Copy-Item .env.example .env
#   2. Điền giá trị thực vào các trường bên dưới
#   3. KHÔNG bao giờ commit file .env lên git
# ================================================

# ── Database (Postgres) ──────────────────────────
# Mật khẩu cho user 'banking' trong Postgres
# Yêu cầu: tối thiểu 12 ký tự, có chữ hoa + số + ký tự đặc biệt
DB_PASSWORD=YourStr0ngP@ssword!

# ── JWT Secret (Gateway) ─────────────────────────
# Dùng để ký Reg_Token sau khi verify OTP thành công
# Generate trên Windows PowerShell:
# $bytes = New-Object byte[] 64 
# (New-Object System.Security.Cryptography.RNGCryptoServiceProvider).GetBytes($bytes) 
# [BitConverter]::ToString($bytes).Replace("-","").ToLower()
JWT_SECRET=replace_with_128_char_random_hex_string_here

# ── KDC Master Key ───────────────────────────────
# Dùng để encrypt/decrypt TGT và Ticket_v trong KDC
# PHẢI là chuỗi hex 64 ký tự (32 bytes)
# Generate trên Windows PowerShell:
# $bytes = New-Object byte[] 32
# (New-Object System.Security.Cryptography.RNGCryptoServiceProvider).GetBytes($bytes)
# [BitConverter]::ToString($bytes).Replace("-","").ToLower()
KDC_MASTER_KEY=replace_with_64_char_hex_string_here

# ── SMTP (Gửi OTP qua Email) ─────────────────────
# Dùng Gmail App Password (không dùng mật khẩu Gmail thường)
# Cách lấy Gmail App Password:
#   1. Vào Google Account → Security → 2-Step Verification (bật nếu chưa)
#   2. Google Account → Security → App passwords
#   3. Chọn "Mail" + "Windows Computer" → Generate
#   4. Copy 16 ký tự vào SMTP_PASS bên dưới
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# ── CA Service Settings ──────────────────────────
# Thông tin Subject cho Root CA certificate
# Không ảnh hưởng bảo mật, chỉ dùng cho display
CA_COUNTRY=VN
CA_ORGANIZATION=Mini_App_Banking
CA_COMMON_NAME=Mini_App_Banking Root CA
CA_STORE_STATE_PATH=certs/ca-store/state.json

# Optional certificate extension endpoints embedded into issued certificates.
# Revocation checks in this project still use CA gRPC; these URLs document future CRL/OCSP publication points.
CA_CRL_DISTRIBUTION_POINTS=http://localhost:8080/ca/crl.pem
CA_OCSP_SERVERS=http://localhost:8080/ca/ocsp

# CA gRPC mTLS settings
# CA Service verifies client certificates with GRPC_CLIENT_CA_CERT_PATH.
GRPC_SERVER_CERT_PATH=certs/grpc/ca-server.crt
GRPC_SERVER_KEY_PATH=certs/grpc/ca-server.key
GRPC_CLIENT_CA_CERT_PATH=certs/grpc/client-ca.crt

# Only these verified client certificate Common Names can call RevokeCertificate.
REVOKE_ALLOWED_CLIENT_CNS=api-gateway

# KDC -> CA mTLS client settings
CA_CLIENT_CERT_PATH=certs/grpc/kdc-client.crt
CA_CLIENT_KEY_PATH=certs/grpc/kdc-client.key
CA_CLIENT_CA_CERT_PATH=certs/grpc/ca-server-ca.crt
CA_SERVER_NAME=ca-service
